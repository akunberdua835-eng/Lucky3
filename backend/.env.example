# ==== Backend PT SJM Sawit — contoh environment variables ====
# JANGAN commit file .env yang berisi nilai asli.

# MongoDB Atlas (free M0). Ambil dari Atlas -> Connect -> Drivers -> Python
# Ganti <password> dan pastikan diakhiri parameter retryWrites
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
DB_NAME="ptsjm_sawit"

# Rahasia JWT — buat acak: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET="ganti_dengan_string_acak_64_karakter"

# Admin utama (hash password otomatis disinkronkan saat backend start)
ADMIN_EMAIL="yumaclovstar@gmail.com"
ADMIN_PASSWORD="178910"
# Admin cadangan (opsional, dipisah koma) — otomatis dijadikan role admin & tidak bisa dihapus
BACKUP_ADMIN_EMAILS="admin@ptsjm.co.id"

# Domain frontend yang diizinkan (dipisah koma). WAJIB diisi domain Vercel Anda.
CORS_ORIGINS="https://nama-app-anda.vercel.app,http://localhost:3000"

# Opsional: notifikasi email lewat Resend. Kosong = notifikasi hanya masuk log.
RESEND_API_KEY=""
